<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bitrix_config_list" model="ir.ui.view">
        <field name="name">bitrix.config.list</field>
        <field name="model">bitrix.config</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="webhook_url"/>
                <field name="active"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>


    <record id="view_bitrix_config_form" model="ir.ui.view">
        <field name="name">bitrix.config.form</field>
        <field name="model">bitrix.config</field>

        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_now"
                            type="object"
                            string="Sincronizar ahora"
                            class="btn-primary"/>
                    <button name="action_test_connection"
                            type="object"
                            string="Probar conexión"
                            class="btn-secondary"/>
                    <button name="action_import_contacts"
                            type="object"
                            string="Importar contactos"
                            class="btn-secondary"/>
                    <button name="action_setup_project_fields"
                            type="object"
                            string="Preparar campos de obra en Bitrix24"
                            groups="base.group_system"/>
                </header>

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="webhook_url" password="True"/>
                        <field name="active"/>
                        <field name="sync_interval"/>
                        <field name="project_responsible_id"/>
                        <field name="last_sync" readonly="True"/>
                    </group>

                    <notebook>
                        <page string="Avance de obras" groups="base.group_system">
                            <group string="Campos personalizados del negocio en Bitrix24">
                                <field name="deal_field_project_code" placeholder="UF_CRM_..."/>
                                <field name="deal_field_project_state" placeholder="UF_CRM_..."/>
                                <field name="deal_field_project_progress" placeholder="UF_CRM_..."/>
                                <field name="deal_field_project_end_date" placeholder="UF_CRM_..."/>
                                <field name="deal_field_next_milestone" placeholder="UF_CRM_..."/>
                                <field name="deal_field_milestone_date" placeholder="UF_CRM_..."/>
                                <field name="deal_field_delay_days" placeholder="UF_CRM_..."/>
                                <field name="deal_field_progress_update" placeholder="UF_CRM_..."/>
                                <field name="deal_field_client_contact" placeholder="UF_CRM_..."/>
                                <field name="client_notification_mode"/>
                            </group>
                        </page>
                        <page string="Eventos Bitrix24" groups="base.group_system">
                            <group string="Webhook saliente del portal">
                                <field name="event_member_id"/>
                                <field name="event_application_token" password="True"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Configure en Bitrix24 los eventos OnCrmDealAdd y OnCrmDealUpdate
                                hacia https://SU-DOMINIO/bitrix24/events/deal.
                            </div>
                        </page>
                        <page string="Responsables" groups="base.group_system">
                            <field name="user_mapping_ids">
                                <list editable="bottom">
                                    <field name="bitrix_user_id"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sincronización incremental" groups="base.group_system">
                            <group>
                                <field name="contacts_cursor" readonly="1"/>
                                <field name="companies_cursor" readonly="1"/>
                                <field name="deals_cursor" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <record id="action_bitrix_config" model="ir.actions.act_window">
        <field name="name">Bitrix24</field>
        <field name="res_model">bitrix.config</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="menu_bitrix_root"
        name="Bitrix24"
        groups="base.group_system"
        sequence="50"
    />

    <menuitem
        id="menu_bitrix_config"
        name="Configuración"
        parent="menu_bitrix_root"
        action="action_bitrix_config"
        sequence="10"
    />

</odoo>
