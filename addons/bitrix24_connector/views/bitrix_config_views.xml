<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bitrix_config_list" model="ir.ui.view">
        <field name="name">bitrix.config.list</field>
        <field name="model">bitrix.config</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="webhook_url"/>
                <field name="active"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>


    <record id="view_bitrix_config_form" model="ir.ui.view">
        <field name="name">bitrix.config.form</field>
        <field name="model">bitrix.config</field>

        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_now"
                            type="object"
                            string="Sincronizar ahora"
                            class="btn-primary"/>
                    <button name="action_test_connection"
                            type="object"
                            string="Probar conexión"
                            class="btn-secondary"/>
                    <button name="action_import_contacts"
                            type="object"
                            string="Importar contactos"
                            class="btn-secondary"/>
                </header>

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="webhook_url" password="True"/>
                        <field name="active"/>
                        <field name="sync_interval"/>
                        <field name="project_responsible_id"/>
                        <field name="last_sync" readonly="True"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="action_bitrix_config" model="ir.actions.act_window">
        <field name="name">Bitrix24</field>
        <field name="res_model">bitrix.config</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="menu_bitrix_root"
        name="Bitrix24"
        sequence="50"
    />

    <menuitem
        id="menu_bitrix_config"
        name="Configuración"
        parent="menu_bitrix_root"
        action="action_bitrix_config"
        sequence="10"
    />

</odoo>
