<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_partner_form_bitrix" model="ir.ui.view">
        <field name="name">res.partner.form.bitrix</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Bitrix24" name="bitrix24" groups="base.group_system">
                    <group>
                        <field name="bitrix_contact_id"/>
                        <field name="bitrix_company_id"/>
                        <field name="bitrix_last_sync"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
