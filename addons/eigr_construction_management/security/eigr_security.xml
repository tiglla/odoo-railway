<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_eigr_construction" model="res.groups.privilege">
        <field name="name">Gestión de Obras EIGR</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_eigr_user" model="res.groups">
        <field name="name">Equipo de obra</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_eigr_construction"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_eigr_responsible" model="res.groups">
        <field name="name">Responsable General</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_eigr_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_eigr_user'))]"/>
    </record>

    <record id="group_eigr_planner" model="res.groups">
        <field name="name">Ingeniería de Planeamiento</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_eigr_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_eigr_user'))]"/>
    </record>

    <record id="group_eigr_resident" model="res.groups">
        <field name="name">Residente de Obra</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_eigr_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_eigr_user'))]"/>
    </record>

    <record id="group_eigr_manager" model="res.groups">
        <field name="name">Jefe de Control</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_eigr_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_eigr_user')), (4, ref('purchase.group_purchase_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_eigr_admin" model="res.groups">
        <field name="name">Administrador de Obras</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="privilege_eigr_construction"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[
            (4, ref('group_eigr_responsible')),
            (4, ref('group_eigr_planner')),
            (4, ref('group_eigr_resident')),
            (4, ref('group_eigr_manager'))
        ]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_eigr_admin'))]"/>
    </record>

    <data noupdate="1">
