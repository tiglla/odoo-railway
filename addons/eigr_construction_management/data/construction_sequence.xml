<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_eigr_construction_project" model="ir.sequence">
        <field name="name">Obra EIGR</field>
        <field name="code">eigr.construction.project</field>
        <field name="prefix">EIGR-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_eigr_construction_budget" model="ir.sequence">
        <field name="name">Presupuesto EIGR</field>
        <field name="code">eigr.construction.budget</field>
        <field name="prefix">PRE-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_eigr_construction_valuation" model="ir.sequence">
        <field name="name">Valorización EIGR</field>
        <field name="code">eigr.construction.valuation</field>
        <field name="prefix">VAL-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_eigr_construction_requirement" model="ir.sequence">
        <field name="name">Requerimiento de Obra EIGR</field>
        <field name="code">eigr.construction.requirement</field>
        <field name="prefix">REQ-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_eigr_construction_closure" model="ir.sequence">
        <field name="name">Cierre de Obra EIGR</field>
        <field name="code">eigr.construction.closure</field>
        <field name="prefix">CIE-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_eigr_construction_technical_file" model="ir.sequence">
        <field name="name">Expediente técnico EIGR</field>
        <field name="code">eigr.construction.technical_file</field>
        <field name="prefix">EXP-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
