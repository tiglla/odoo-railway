<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_eigr_client_progress" model="mail.template">
        <field name="name">EIGR: avance de obra para cliente</field>
        <field name="model_id" ref="model_eigr_construction_project"/>
        <field name="subject">Avance de obra {{ object.code }}: {{ object.name }}</field>
        <field name="partner_to">{{ object.client_id.id }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Estimado cliente:</p>
                <p>Adjuntamos el informe de avance de la obra <strong t-out="object.name"/>.</p>
                <p>Puede responder a este correo si necesita alguna aclaración.</p>
            </div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('eigr_construction_management.action_report_eigr_project_client'))]"/>
    </record>
</odoo>
