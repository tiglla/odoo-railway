<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eigr_construction_requirement_list" model="ir.ui.view">
        <field name="name">eigr.construction.requirement.list</field>
        <field name="model">eigr.construction.requirement</field>
        <field name="arch" type="xml">
            <list string="Requerimientos" default_order="priority desc, required_date" decoration-danger="priority == '2' and state not in ('received', 'cancelled')" decoration-muted="state == 'cancelled'" decoration-success="state == 'received'">
                <field name="priority" widget="priority"/>
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="requester_id" widget="many2one_avatar_user" optional="show"/>
                <field name="required_date"/>
                <field name="vendor_id" optional="show"/>
                <field name="estimated_total" widget="monetary" sum="Estimado" optional="show"/>
                <field name="ordered_total" widget="monetary" sum="Ordenado" optional="show"/>
                <field name="receipt_progress" widget="progressbar" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'submitted')"
                       decoration-warning="state in ('approved', 'ordered', 'partial')"
                       decoration-success="state == 'received'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_eigr_construction_requirement_kanban" model="ir.ui.view">
        <field name="name">eigr.construction.requirement.kanban</field>
        <field name="model">eigr.construction.requirement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong class="fs-5"><field name="name"/></strong>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="text-muted"><field name="code"/></div>
                        <div><i class="fa fa-building-o me-1" title="Obra"/><field name="project_id"/></div>
                        <div><i class="fa fa-calendar me-1" title="Fecha requerida"/><field name="required_date"/></div>
                        <field name="receipt_progress" widget="progressbar" class="mt-2"/>
                        <footer class="mt-2">
                            <field name="requester_id" widget="many2one_avatar_user"/>
                            <field name="ordered_total" widget="monetary" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eigr_construction_requirement_form" model="ir.ui.view">
        <field name="name">eigr.construction.requirement.form</field>
        <field name="model">eigr.construction.requirement</field>
        <field name="arch" type="xml">
            <form string="Requerimiento de obra">
                <header>
                    <button name="action_submit" string="Enviar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar" type="object" class="btn-primary" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" string="Devolver a borrador" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'submitted'"/>
                    <button name="action_mark_ordered" string="Confirmar orden" type="object" class="btn-primary" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'approved' or purchase_order_id"/>
                    <button name="action_create_purchase_order" string="Crear cotización Odoo" type="object" class="btn-primary" groups="eigr_construction_management.group_eigr_manager" invisible="state != 'approved' or purchase_order_id"/>
                    <button name="action_sync_purchase" string="Actualizar desde compra" type="object" invisible="not purchase_order_id or state not in ('approved', 'ordered', 'partial')"/>
                    <button name="action_view_purchase_order" string="Ver compra Odoo" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="not purchase_order_id"/>
                    <button name="action_update_receipt" string="Actualizar recepción" type="object" class="btn-primary" invisible="state not in ('ordered', 'partial') or purchase_order_id"/>
                    <button name="action_cancel" string="Cancelar" type="object" groups="eigr_construction_management.group_eigr_manager" invisible="state in ('received', 'cancelled')" confirm="¿Confirma la cancelación del requerimiento?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,ordered,partial,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Recursos requeridos para la obra" readonly="state != 'draft'"/></h1>
                        <h2><field name="code" readonly="state != 'draft'"/></h2>
                    </div>
                    <group>
                        <group string="Solicitud">
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="requester_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="required_date" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority" readonly="state != 'draft'"/>
                            <field name="delivery_location" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Compra y recepción">
                            <field name="vendor_id" readonly="state != 'approved' or purchase_order_id"/>
                            <field name="purchase_order_id" invisible="1"/>
                            <field name="purchase_reference" readonly="state != 'approved' or purchase_order_id"/>
                            <field name="purchase_date" readonly="state != 'approved' or purchase_order_id"/>
                            <field name="expected_delivery_date" readonly="state != 'approved' or purchase_order_id"/>
                            <field name="receipt_reference" readonly="state not in ('ordered', 'partial') or purchase_order_id"/>
                            <field name="receipt_date" invisible="state != 'received'"/>
                            <field name="approved_by_id" widget="many2one_avatar_user" invisible="state in ('draft', 'submitted')"/>
                            <field name="approval_date" invisible="state in ('draft', 'submitted')"/>
                        </group>
                    </group>
                    <group string="Resumen de abastecimiento">
                        <field name="estimated_total" widget="monetary"/>
                        <field name="ordered_total" widget="monetary"/>
                        <field name="received_total" widget="monetary"/>
                        <field name="receipt_progress" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Recursos solicitados">
                            <field name="line_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle" readonly="parent.state != 'draft'"/>
                                    <field name="item_type" readonly="parent.state != 'draft'"/>
                                    <field name="name" readonly="parent.state != 'draft'"/>
                                    <field name="product_id" readonly="parent.state != 'draft'"/>
                                    <field name="specification" optional="show" readonly="parent.state != 'draft'"/>
                                    <field name="unit" readonly="parent.state != 'draft'"/>
                                    <field name="quantity_requested" readonly="parent.state != 'draft'"/>
                                    <field name="estimated_unit_cost" widget="monetary" readonly="parent.state != 'draft'"/>
                                    <field name="estimated_subtotal" widget="monetary" sum="Estimado"/>
                                    <field name="quantity_ordered" readonly="parent.state != 'approved' or parent.purchase_order_id"/>
                                    <field name="actual_unit_cost" widget="monetary" readonly="parent.state != 'approved' or parent.purchase_order_id"/>
                                    <field name="ordered_subtotal" widget="monetary" sum="Ordenado"/>
                                    <field name="quantity_received" readonly="parent.state not in ('ordered', 'partial') or parent.purchase_order_id"/>
                                    <field name="purchase_line_id" optional="hide" readonly="1"/>
                                    <field name="received_subtotal" widget="monetary" sum="Recibido" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Justificacion y observaciones">
                            <field name="notes" placeholder="Motivo del requerimiento, condiciones y observaciones..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eigr_construction_requirement_search" model="ir.ui.view">
        <field name="name">eigr.construction.requirement.search</field>
        <field name="model">eigr.construction.requirement</field>
        <field name="arch" type="xml">
            <search string="Buscar requerimientos">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="requester_id"/>
                <field name="vendor_id"/>
                <filter name="urgent" string="Urgentes" domain="[('priority', '=', '2')]"/>
                <filter name="pending_approval" string="Por aprobar" domain="[('state', '=', 'submitted')]"/>
                <filter name="pending_purchase" string="Por comprar" domain="[('state', '=', 'approved')]"/>
                <filter name="pending_receipt" string="Por recibir" domain="[('state', 'in', ('ordered', 'partial'))]"/>
                <filter name="received" string="Recibidos" domain="[('state', '=', 'received')]"/>
                <separator/>
                <filter name="my_projects" string="Mis obras" domain="['|', '|', '|', ('project_id.responsible_id', '=', uid), ('project_id.control_manager_id', '=', uid), ('project_id.planning_engineer_id', '=', uid), ('project_id.resident_id', '=', uid)]"/>
                <group name="group_by">
                    <filter name="group_project" string="Obra" context="{'group_by': 'project_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_vendor" string="Proveedor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_required" string="Fecha requerida" context="{'group_by': 'required_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eigr_construction_requirement" model="ir.actions.act_window">
        <field name="name">Requerimientos</field>
        <field name="res_model">eigr.construction.requirement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_eigr_construction_requirement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree un requerimiento de obra</p>
            <p>Controle la solicitud, compra y recepción de materiales, equipos y servicios.</p>
        </field>
    </record>
</odoo>
